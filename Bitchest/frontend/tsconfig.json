{
  "extends": "@vue/tsconfig/tsconfig.dom.json",  // Très important ! Il inclut automatiquement les bonnes lib DOM
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    // Optionnel mais recommandé pour Vue
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    // Strict mode (tu peux l'assouplir si trop strict au début)
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}